POSTGRES_DB=ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5433

ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Database=ragforge;Username=ragforge;Password=change-this-local-password"

# Embeddings: any OpenAI-compatible /embeddings endpoint. Claude and DeepSeek do not offer
# embeddings, so this stays on OpenAI (or another compatible service) whichever chat provider you pick.
Embedding__BaseUrl="https://api.openai.com/v1/"
Embedding__ApiKey="replace-with-your-openai-api-key"
Embedding__Model="text-embedding-3-small"

# Chat: pick ONE provider block. An empty Chat__Model uses the provider default shown in the comment.

# OpenAI (default model: gpt-4o-mini). The key can be the same one used for embeddings.
Chat__Provider="OpenAI"
Chat__ApiKey="replace-with-your-openai-api-key"
Chat__Model=""

# Claude API (default model: claude-opus-5-5; claude-haiku-5-5 is the low-cost option).
# Chat__Provider="Anthropic"
# Chat__ApiKey="replace-with-your-anthropic-api-key"
# Chat__Model=""

# DeepSeek (default model: deepseek-v4-pro; deepseek-flash is the low-cost option).
# Chat__Provider="DeepSeek"
# Chat__ApiKey="replace-with-your-deepseek-api-key"
# Chat__Model=""

# Host port for the API when it runs through Docker Compose.
API_PORT=5190
