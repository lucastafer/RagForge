@RagForge_HostAddress = http://localhost:5190

GET {{RagForge_HostAddress}}/health
Accept: application/json

###

POST {{RagForge_HostAddress}}/api/documents
Content-Type: multipart/form-data; boundary=RagForgeBoundary

--RagForgeBoundary
Content-Disposition: form-data; name="file"; filename="rag-overview.md"
Content-Type: text/markdown

< ./samples/rag-overview.md
--RagForgeBoundary--

###

POST {{RagForge_HostAddress}}/api/questions
Content-Type: application/json

{
  "question": "What are the main stages of the RAG pipeline?",
  "topK": 5
}
